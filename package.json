{
  "name": "mkb-notes",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "SPA-приложение для заметок с Todo-списками (Nuxt 4, Pinia, SCSS)",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@pinia/nuxt": "0.11.3",
    "nuxt": "4.3.1",
    "pinia": "3.0.4",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.0.0",
    "prettier": "^3.10.1",
    "sass": "^1.93.0",
    "typescript": "~5.9.0",
    "vitest": "~4.1.0",
    "vue-tsc": "^3.1.0"
  },
  "overrides": {
    "eslint-flat-config-utils": "3.0.2"
  }
}
